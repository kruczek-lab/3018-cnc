# 3018 Studio settings on the Raspberry Pi.
# Edit with:   sudo nano /etc/default/3018-studio
# Apply with:  sudo systemctl restart 3018-studio

# Web address port: http://<pi-name>.local:8018
STUDIO_PORT=8018

# Password for the web page. Leave empty to let anyone on your network use the machine.
STUDIO_PASSWORD=

# Serial port of the 3018. Leave empty to use the first USB serial device found.
STUDIO_SERIAL_PORT=

# 1 = connect to the machine when the Pi starts; 0 = wait for the Connect button.
STUDIO_AUTOCONNECT=1
